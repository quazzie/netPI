<Project Sdk="Microsoft.NET.Sdk">
  <!-- NetPI host kernel: plugin manager, registries, event bus, SQLite, settings, session store, model catalog and
       the Kestrel web/WebSocket server. Used in-process by both netpi-server and the desktop shell. -->
  <PropertyGroup>
    <RootNamespace>NetPI.Host</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NetPI.Abstractions/NetPI.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The auxiliary plugin tests need the real <c>Database</c> (a plugin that owns SQLite tables has to be exercised
         against real temporary databases, not a fake that cannot roll back or enforce a unique index). -->
    <InternalsVisibleTo Include="NetPI.Host.Tests" />
    <InternalsVisibleTo Include="NetPI.Aux.Tests" />
    <InternalsVisibleTo Include="NetPI.Storage.Tests" />
    <InternalsVisibleTo Include="NetPI.Tools.Tests" />
    <InternalsVisibleTo Include="NetPI.Providers.Tests" />
    <!-- The one-off storage migration (scripts/migrations/001-storage-port) opens the sqlite provider and reads the old database. -->
    <InternalsVisibleTo Include="NetPI.Migration001" />
  </ItemGroup>
</Project>

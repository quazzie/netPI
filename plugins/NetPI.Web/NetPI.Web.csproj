<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>NetPI.Web</RootNamespace>
    <AssemblyName>netPI.Web</AssemblyName>
    <Description>Web surface: Kestrel, native WebSocket, static frontend serving (PLAN §36, §41). Reloadable netPI plugin.</Description>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\NetPI.Abstractions\NetPI.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Panel pages served from the plugin assembly (see WebApp.PanelHtml). -->
    <EmbeddedResource Include="panels\plugins.html" />
  </ItemGroup>
</Project>

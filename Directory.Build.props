<Project>
  <!-- Shared build settings for every NetPI project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <!-- Where a build lands: executables, wwwroot and plugins/<Name>/. The DEFAULT is the dev tree, never artifacts/app:
         a running NetPI loads its plugins from artifacts/app and reloads one as soon as its file changes, so a plain
         `dotnet build` (of a plugin, or of a test project that references one) must not write there — that takes tools
         away from every open chat. build.ps1 -Publish is the one thing that installs into artifacts/app. -->
    <AppOutDir>$(RepoRoot)artifacts/dev/app/</AppOutDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS1591;CA2255</NoWarn>
    <Version>0.1.0</Version>
    <Authors>NetPI</Authors>
    <Deterministic>true</Deterministic>
    <!-- No commit hash in the informational version: after a commit, unchanged projects stay byte-identical, so a running
         NetPI does not hot-reload every plugin, and build.ps1 can tell whether the host really changed. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>

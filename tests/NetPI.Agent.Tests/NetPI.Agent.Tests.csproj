<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console test runner for the agent runtime plugins (no test framework: NuGet is not available).
       Build the plugins first, then: dotnet build -p:BuildProjectReferences=false && dotnet bin/Debug/NetPI.Agent.Tests.dll [filter...] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>NetPI.Agent.Tests</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- the runtime plugin (NetPI.Runtime) is what most tests drive -->
    <Using Include="NetPI.Runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetPI.Abstractions/NetPI.Abstractions.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Agents/NetPI.Agents.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Ask/NetPI.Ask.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Context/NetPI.Context.csproj" />
    <ProjectReference Include="../../plugins/NetPI.AgentsMd/NetPI.AgentsMd.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Runtime/NetPI.Runtime.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Tools.Agents/NetPI.Tools.Agents.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Goal/NetPI.Goal.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Guardrails/NetPI.Guardrails.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Loops/NetPI.Loops.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Profiles/NetPI.Profiles.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Skills/NetPI.Skills.csproj" />
  </ItemGroup>
</Project>

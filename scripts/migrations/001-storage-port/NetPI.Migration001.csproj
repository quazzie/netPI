<Project Sdk="Microsoft.NET.Sdk">
  <!-- The one-off migration of an old-format NetPI home to the storage port's shape (docs/plans/2026-10-02-replaceable-parts.md,
       "Cutover and rollback"). Run it with dotnet from this folder: see Program.cs for the arguments (a dry run by
       default, apply only after a passing verification, and a selftest that builds an old-format database in a temp
       directory). It never modifies the old database; the new one is built in <dir>/.migrating, verified, and moved
       into place only by the apply flag. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NetPI.Migration001</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\NetPI.Contracts\NetPI.Contracts.csproj" />
    <ProjectReference Include="..\..\..\src\NetPI.Host\NetPI.Host.csproj" />
  </ItemGroup>
</Project>

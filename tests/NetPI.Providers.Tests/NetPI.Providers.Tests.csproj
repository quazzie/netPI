<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console test runner for the provider plugins (no xunit: NuGet is unavailable). Run the built exe: bin/Debug/NetPI.Providers.Tests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>NetPI.Providers.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetPI.Abstractions/NetPI.Abstractions.csproj" />
    <ProjectReference Include="../../src/NetPI.Contracts/NetPI.Contracts.csproj" />
    <!-- The real memory storage provider, so the plugin-context fake hands a plugin a real IPluginData. -->
    <ProjectReference Include="../../src/NetPI.Host/NetPI.Host.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Providers.AiProxy/NetPI.Providers.AiProxy.csproj" Aliases="aiproxy" />
    <ProjectReference Include="../../plugins/NetPI.Providers.Anthropic/NetPI.Providers.Anthropic.csproj" Aliases="anthropic" />
    <ProjectReference Include="../../plugins/NetPI.Providers.OpenRouter/NetPI.Providers.OpenRouter.csproj" Aliases="openrouter" />
  </ItemGroup>
</Project>

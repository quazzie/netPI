{
  "name": "netpi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "NetPI web UI (Svelte 5 + Vite) and plugin UI build pipeline",
  "scripts": {
    "build": "npm run build:web && npm run build:plugins",
    "build:web": "vite build --config web/vite.config.js && node web/scripts/sync-dist.mjs",
    "build:plugins": "node web/scripts/build-plugins.mjs",
    "dev": "vite --config web/vite.config.js",
    "mock": "node web/scripts/build-plugins.mjs --only web/mock/sample-plugin && node web/mock/server.mjs",
    "e2e": "node web/mock/e2e.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.1",
    "vite": "^8.3.0",
    "ws": "^8.21.3"
  }
}

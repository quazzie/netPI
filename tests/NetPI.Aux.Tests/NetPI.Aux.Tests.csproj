<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console test runner for the auxiliary plugins (retry, nudge, tool repair, compaction, ideas, work, diagnostics).
       No test framework (NuGet is not available). Run the built exe, optionally with test-name filters. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>NetPI.Aux.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/NetPI.Abstractions/NetPI.Abstractions.csproj" />
    <!-- The contracts the plugins share (workspace bindings, event names): reached through the plugins, but the test
         runner has to load the assembly itself, so it is a reference here too. -->
    <ProjectReference Include="../../src/NetPI.Contracts/NetPI.Contracts.csproj" />
    <!-- The real SQLite, so the plugins that own tables (netpi.ideas) are tested against actual databases. -->
    <ProjectReference Include="../../src/NetPI.Host/NetPI.Host.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Mcp/NetPI.Mcp.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Retry/NetPI.Retry.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Nudge/NetPI.Nudge.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Loops/NetPI.Loops.csproj" />
    <ProjectReference Include="../../plugins/NetPI.ToolRepair/NetPI.ToolRepair.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Compaction/NetPI.Compaction.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Ideas/NetPI.Ideas.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Work/NetPI.Work.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Diagnostics/NetPI.Diagnostics.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Todo/NetPI.Todo.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Tools.Web/NetPI.Tools.Web.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Tools.Media/NetPI.Tools.Media.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Decide/NetPI.Decide.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Tools.Ssh/NetPI.Tools.Ssh.csproj" />
    <!-- workspaces: the tests drive real git worktrees, the file tools' guard and the shell's cwd. -->
    <ProjectReference Include="../../plugins/NetPI.Workspaces/NetPI.Workspaces.csproj" />
    <!-- The real model/tool loop, so a workspace switch can be watched across model calls (idea-y0i6gu). -->
    <ProjectReference Include="../../plugins/NetPI.Runtime/NetPI.Runtime.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Tools.Files/NetPI.Tools.Files.csproj" />
    <ProjectReference Include="../../plugins/NetPI.Tools.Shell/NetPI.Tools.Shell.csproj" />
  </ItemGroup>
</Project>

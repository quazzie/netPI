{
  "manifest_version": 3,
  "name": "NetPI",
  "version": "1.0.0",
  "description": "Share a tab of your Chrome with a NetPI chat, and let NetPI's agents open tabs here (no remote-debugging switch).",
  "minimum_chrome_version": "125",
  "permissions": ["debugger", "tabs", "alarms", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "NetPI: share this tab", "default_popup": "popup.html" }
}

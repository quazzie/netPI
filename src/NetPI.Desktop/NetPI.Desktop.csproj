<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NetPI.Desktop</RootNamespace>
    <AssemblyName>netPI.Desktop</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <!-- WinForms control ships in lib_manual (not auto-resolved for net10). -->
  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.WinForms">
      <HintPath>C:\Users\quazz\.nuget\packages\microsoft.web.webview2\1.0.2903.40\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.WinForms.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Build the host first (without adding a reference assembly to this app). -->
  <ItemGroup>
    <ProjectReference Include="..\NetPI.Host\NetPI.Host.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Ship the host next to the shell so the app is self-contained. -->
  <ItemGroup>
    <HostFiles Include="..\NetPI.Host\bin\$(Configuration)\net10.0\**\*"
               Condition="Exists('..\NetPI.Host\bin\$(Configuration)\net10.0')" />
  </ItemGroup>
  <Target Name="CopyHostApp" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath)host" />
    <Copy SourceFiles="@(HostFiles)" DestinationFolder="$(OutputPath)host\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>

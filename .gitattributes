* text=auto
# C# sources must be byte-stable across checkouts: the PDB checksums the raw source bytes, so a line-ending flip
# (autocrlf on, a tool writing LF) would change every DLL with no visible source change and break the
# byte-identical-rebuild guarantee the hot-reload and the contracts check in build.ps1 rely on.
*.cs text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.png binary
*.ico binary
# UI source must build identically on Windows and Unix without manual conversion.
web/src/** text=auto eol=lf
web/public/** text=auto eol=lf
# Vite copies this file's working-tree bytes into web/dist/index.html (binary below): LF here, or a Unix build
# leaves the committed copy "modified" on every run.
web/index.html text=auto eol=lf
plugins/*/ui/** text=auto eol=lf
# Generated bundles: the build writes these byte-for-byte (LF). Git must not rewrite their line
# endings or every build leaves them "modified" with an empty diff (CRLF checkout form vs LF build form).
web/dist/** binary
plugins/**/wwwroot/ui.js binary

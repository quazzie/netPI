<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NetPI desktop shell: a WinForms window hosting WebView2. It starts the NetPI server in-process
    (NetPI.Host) and navigates the webview to it. Windows only.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>NetPI</AssemblyName>
    <RootNamespace>NetPI.Desktop</RootNamespace>
    <OutDir>$(AppOutDir)</OutDir>
    <ApplicationIcon>netpi.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <IsPackable>false</IsPackable>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Floating version: always the latest 1.0.x WebView2 SDK available on nuget.org. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../NetPI.Host/NetPI.Host.csproj" />
    <ProjectReference Include="../NetPI.Abstractions/NetPI.Abstractions.csproj" />
    <!-- Build order only: netpi-server (same output folder) also copies the web UI into wwwroot. -->
    <ProjectReference Include="../NetPI.Server/NetPI.Server.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="netpi.ico" LogicalName="netpi.ico" />
  </ItemGroup>

  <!-- The WebView2 package references its WPF control for every .NET 5+ app. This shell is WinForms only, and that
       assembly's WindowsBase 5.0 conflicts with the reference pack (MSB3277): drop it before references resolve. -->
  <Target Name="NetPiDropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>

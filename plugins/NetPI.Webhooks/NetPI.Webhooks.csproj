<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="NetPI.Aux.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared SOURCE, not a shared assembly (docs/PLUGINS.md): the plugin listener, its address allow list and its wrong-token throttle. -->
    <Compile Include="$(RepoRoot)shared/ListenerKit/*.cs" LinkBase="ListenerKit" />
    <Using Include="NetPI.ListenerKit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Shared SOURCE, not a shared assembly (docs/PLUGINS.md): job objects for child processes. -->
    <Compile Include="$(RepoRoot)shared/ProcessKit/*.cs" LinkBase="ProcessKit" />
    <Using Include="NetPI.ProcessKit" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- bash (Git Bash on Windows) / pwsh tools, background process registry + processes.* RPC. -->
  <PropertyGroup>
    <Description>NetPI shell tools (bash, pwsh, background processes).</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="NetPI.Tools.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The git kit is shared SOURCE, not a shared assembly (docs/PLUGINS.md): the shell tools use it to see what a
         command changed in its repository (ChangeTracker). -->
    <Compile Include="$(RepoRoot)shared/GitKit/*.cs" LinkBase="GitKit" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="NetPI.GitKit" />
  </ItemGroup>
</Project>
